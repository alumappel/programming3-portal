*.backup
*.zip
*.7z
*.rar
*.pem
*.key
*.p12
*.pfx

# Installed dependencies, deployment caches, and test output.
node_modules/
.wrangler/
test-results/
playwright-report/
coverage/
*.log
*.pid

# Personal editor settings and operating system files.
.idea/
*.code-workspace
.DS_Store
Thumbs.db
